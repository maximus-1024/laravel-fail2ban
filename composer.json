{
    "name": "maximus-1024/laravel-fail2ban",
    "description": "Automatic banning of abusive visitors for Laravel, with a management panel.",
    "keywords": ["laravel", "fail2ban", "redis"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/redis": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/view": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-redis": "Required at runtime: the package only supports the phpredis client (database.redis.client = phpredis); predis is not supported."
    },
    "autoload": {
        "psr-4": {
            "Maximus\\Fail2Ban\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maximus\\Fail2Ban\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maximus\\Fail2Ban\\Fail2BanServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "compile-rules": "@php bin/compile-rules"
    }
}
